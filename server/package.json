{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "node -r ./scripts/load-root-env.cjs ../node_modules/prisma/build/index.js generate --schema=prisma/schema.prisma",
    "db:push": "node -r ./scripts/load-root-env.cjs ../node_modules/prisma/build/index.js db push --schema=prisma/schema.prisma",
    "smoke": "tsx scripts/e2e-smoke.ts",
    "test:parser": "tsx scripts/test-parser.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "nodemailer": "^10.0.9",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
