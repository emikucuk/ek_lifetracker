# EK LifeTracker — ortam değişkeni şablonu
# Kopyala:  copy .env.example .env
# Sonra değerleri doldur. Gerçek .env git'e / paylaşıma girmez.

PORT=3081
CLIENT_ORIGIN=http://localhost:5181

# Prisma SQLite — göreli yol server/prisma çalışma dizinine göre çözülür
DATABASE_URL=file:./dev.db

# Siri / Kestirmeler voice API (güçlü rastgele bir değer koy)
VOICE_API_KEY=change-me-to-a-long-random-secret

# Yerel Ollama (yoksa parser sessizce kurallara düşer)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_MS=8000
PARSER_LLM_MIN_CONFIDENCE=0.7

# Otomatik arşiv yedeği → proje/backups/*.zip
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=6
AUTO_BACKUP_KEEP=20
# AUTO_BACKUP_DIR=backups

# Yedek sonrası GitHub push (ayrı `backups` dalı; main kirlenmez)
AUTO_BACKUP_GIT_PUSH=true
AUTO_BACKUP_GIT_REMOTE=origin
AUTO_BACKUP_GIT_BRANCH=backups

# Not: SMTP / e-posta ayarları .env'de değil — panel Ayarlar → E-posta
# (AppSetting tablosunda saklanır; yedek JSON içinde ayarlar yoksa panelden yeniden gir)
